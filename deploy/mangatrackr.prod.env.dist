# Modèle du fichier de secrets de production de MangaTrackr (VM apps-dev).
#
# Copier vers /opt/apps/secrets/mangatrackr.prod.env (fait par deploy/install-vm.sh s'il est absent),
# remplacer CHAQUE valeur <...>, puis protéger : chmod 600 (répertoire /opt/apps/secrets : 700).
# Ce fichier versionné ne contient QUE des exemples : ne jamais y écrire de vraie valeur.
#
# Format : fichier `env_file` de Docker Compose (une ligne CLE=valeur, sans `export`).
#  - Compose interpole `$VAR` / `${VAR}` dans les valeurs non entourées d'apostrophes : si une
#    valeur contient un `$`, l'entourer d'apostrophes simples ('...').
#  - Les variables sont lues à la création des conteneurs : après modification, recréer le
#    service concerné SANS reconstruire ni mettre à jour le code (pas deploy/deploy.sh) :
#      docker compose -f compose.prod.yaml up -d --no-deps --no-build app      (puis worker)

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Générer une valeur propre à la production : openssl rand -hex 32
APP_SECRET=<a-generer-avec-openssl-rand-hex-32>
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Serveur PostgreSQL 18 mutualisé : conteneur `postgres`, joint par son nom sur le réseau Docker
# `database` (port 5432, non publié sur la VM). Base et rôle applicatif : `mangatrackr`
# (créés par deploy/init-database.sh). Ne jamais utiliser le superutilisateur du conteneur.
# serverVersion=18 obligatoire (ADR 0012).
# Mot de passe : caractères spéciaux percent-encodés (ex. `@` -> %40, `/` -> %2F, `%` -> %25),
# PUIS chaque `%` doublé (`%%`), car DATABASE_URL passe par %env(resolve:)% de Symfony.
# Exemple : mot de passe `a@b` -> `a%40b` -> écrire `a%%40b`.
DATABASE_URL="postgresql://mangatrackr:<mot-de-passe-encode-et-%%-double>@postgres:5432/mangatrackr?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Transport Doctrine (table messenger_messages créée par la baseline : auto_setup=0).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Envoi d'emails désactivé tant qu'aucun relais SMTP n'est configuré : garder null://null.
# Plus tard : smtp://<utilisateur>:<mot-de-passe-encode>@<hote>:<port>
MAILER_DSN=null://null
MAILER_CONTACT=<contact@exemple.invalid>
MAILER_NO_REPLY=<no-reply@exemple.invalid>
###< symfony/mailer ###

###> App infos ###
APP_NAME=MangaTracker
APP_TEAM_NAME_1=<nom-equipe-1>
APP_TEAM_NAME_2=<nom-equipe-2>
APP_VERSION=<x.y.z>
###< App infos ###

###> API externes ###
API_TENRAI_URL=https://api.tenrai.org/v1
API_MANGA_UPDATES_URL=https://api.mangaupdates.com/v1
###< API externes ###

###> OAuth Google ###
# Connexion Google reportée (nécessite le reverse proxy HTTPS et un domaine public).
# Identifiants de la console Google Cloud ; le secret client ne doit apparaître nulle part ailleurs.
OAUTH_GOOGLE_CLIENT_ID=<identifiant-client>.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=<secret-client-google>
###< OAuth Google ###

###> Emails authorized for Oauth Tests ###
# Liste séparée par des virgules (peut rester vide).
OAUTH_TEST_EMAILS=
###< Emails authorized for Oauth Tests ###
